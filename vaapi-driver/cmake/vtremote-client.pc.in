prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vtremote-client
Description: Dependency-light VTRemote v1 TCP client
Version: @VTREMOTE_VERSION@
Requires.private: liblz4 libzstd
Libs: -L${libdir} -lvtremote_client
Cflags: -I${includedir}
